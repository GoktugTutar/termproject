generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int                  @id @default(autoincrement())
  email              String               @unique
  passwordHash       String
  preferredStudyTime StudyTime            @default(morning)
  studyStyle         StudyStyle           @default(normal)
  currentTermStartedAt DateTime?           @default(now())
  gradeLevel         Int?
  gpa                Float?
  academicTerm       String?
  avatarSvg          String?
  avatarOptions      Json?
  checklists         DailyChecklist[]
  lessons            Lesson[]
  planOverrides      LessonPlanOverride[]
  scheduledBlocks    ScheduledBlock[]
  profile            StudentProfile?
  feedbackLogs       SystemFeedbackLog[]
  terms              Term[]
  busySlots          UserBusySlot[]
  weeklyFeedbacks    WeeklyFeedback[]
  examResults    ExamResult[]
}

model StudentProfile {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique
  updatedAt               DateTime @updatedAt
  completionRate7d        Float    @default(0)
  avgStress7d             Float    @default(3)
  dowCompletionRates      String   @default("[0,0,0,0,0,0,0]")
  sweetSpotBlocks         Float    @default(2)
  stressNearExam          Float    @default(3)
  consistencyScore        Float    @default(0)
  totalSubmissions        Int      @default(0)
  badSleepAvgStress       Float?
  badSleepCompletionRate  Float?
  goodSleepAvgStress      Float?
  goodSleepCompletionRate Float?
  user                    User     @relation(fields: [userId], references: [id])
}

model UserBusySlot {
  id           Int       @id @default(autoincrement())
  userId       Int
  dayOfWeek    Int
  startTime    String
  endTime      String
  fatigueLevel Int
  date         DateTime?
  iconKey      String    @default("energy")
  isRoutine    Boolean   @default(true)
  user         User      @relation(fields: [userId], references: [id])
}

model Term {
  id        Int       @id @default(autoincrement())
  userId    Int
  name      String?
  isActive  Boolean   @default(true)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  lessons   Lesson[]
  user      User      @relation(fields: [userId], references: [id])
}

model Lesson {
  id                  Int              @id @default(autoincrement())
  userId              Int
  name                String
  difficulty          Int
  keyfiDelayCount     Int              @default(0)
  zorunluDelayCount   Int              @default(0)
  zorunluMissedBlocks Int              @default(0)
  needsMoreTime       Int              @default(0)
  termId              Int?
  term                Term?            @relation(fields: [termId], references: [id])
  user                User             @relation(fields: [userId], references: [id])
  deadlines           LessonDeadline[]
  exams               LessonExam[]
  scheduledBlocks     ScheduledBlock[]
  examResults    ExamResult[]
}

model LessonExam {
  id       Int      @id @default(autoincrement())
  lessonId Int
  examDate DateTime
  lesson   Lesson   @relation(fields: [lessonId], references: [id])
  results        ExamResult[]
}

model LessonDeadline {
  id           Int      @id @default(autoincrement())
  lessonId     Int
  deadlineDate DateTime
  title        String?
  lesson       Lesson   @relation(fields: [lessonId], references: [id])
}

model ScheduledBlock {
  id         Int      @id @default(autoincrement())
  userId     Int
  lessonId   Int
  date       DateTime
  startTime  String
  endTime    String
  blockCount Int
  isReview   Boolean  @default(false)
  completed  Boolean  @default(false)
  weekStart  DateTime
  lesson     Lesson   @relation(fields: [lessonId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model DailyChecklist {
  id          Int             @id @default(autoincrement())
  userId      Int
  date        DateTime
  stressLevel Int             @default(3)
  sleptWell   Boolean?
  items       ChecklistItem[]
  user        User            @relation(fields: [userId], references: [id])
}

model ChecklistItem {
  id              Int            @id @default(autoincrement())
  checklistId     Int
  lessonId        Int
  plannedBlocks   Int
  completedBlocks Int            @default(0)
  delayed         Boolean        @default(false)
  checklist       DailyChecklist @relation(fields: [checklistId], references: [id])
}

model WeeklyFeedback {
  id               Int              @id @default(autoincrement())
  userId           Int
  weekStart        DateTime
  weekloadFeedback String
  lessonFeedbacks  LessonFeedback[]
  user             User             @relation(fields: [userId], references: [id])
}

model LessonFeedback {
  id               Int            @id @default(autoincrement())
  weeklyFeedbackId Int
  lessonId         Int
  needsMoreTime    Int
  weeklyFeedback   WeeklyFeedback @relation(fields: [weeklyFeedbackId], references: [id])
}

model SystemFeedbackLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String
  lessonId    Int?
  triggeredAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, type, lessonId])
}

model LessonPlanOverride {
  id                 Int      @id @default(autoincrement())
  userId             Int
  lessonId           Int?
  weekStart          DateTime
  priorityBoost      Int      @default(0)
  preferEarlySlot    Boolean  @default(false)
  maxSessionBlocks   Int?
  multiplierOverride Float?
  createdAt          DateTime @default(now())
  addReviewBlock     Boolean  @default(false)
  user               User     @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId, weekStart])
  @@index([userId, weekStart])
}

enum StudyTime {
  morning
  afternoon
  evening
  night
}

enum StudyStyle {
  deep_focus
  distributed
  normal
}

model ExamResult {
  id         Int             @id @default(autoincrement())
  userId     Int
  lessonId   Int
  examId     Int
  grade      String?
  satisfied  Boolean?
  failReason ExamFailReason?
  createdAt  DateTime        @default(now())

  user       User            @relation(fields: [userId], references: [id])
  lesson     Lesson          @relation(fields: [lessonId], references: [id])
  exam       LessonExam      @relation(fields: [examId], references: [id])

  @@index([userId, lessonId])
  @@index([userId, examId])
}

enum ExamFailReason {
  insufficient_preparation
  poor_understanding
  exam_anxiety
  time_management_in_exam
  poor_sleep_before
  overwhelmed_by_workload
  lack_of_focus
}
